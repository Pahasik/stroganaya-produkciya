# Скопируйте этот файл в .env.local и укажите свои значения.
# .env.local в репозиторий не попадает.

# Адрес обработчика заявок (POST, JSON).
# Пока переменная не задана, форма работает в демонстрационном режиме
# и НЕ отправляет данные. Подробнее — src/lib/submitLead.ts
VITE_LEAD_ENDPOINT=

# Базовый путь сборки. Локально не нужен.
# На GitHub Pages подставляется автоматически в .github/workflows/deploy.yml
# VITE_BASE=/имя-репозитория/
